{
  "seed": 0,
  "epochs": 1,
  "batch_size": 8,
  "initial_checkpoint": "${HETT_INITIAL_CHECKPOINT}",
  "base_arguments": "${HETT_BASE_ARGUMENTS}",
  "evaluation_splits": [
    "val_seen",
    "val_unseen"
  ],
  "evaluate_every": 1,
  "selection_policy": "optional_path_ablation_not_mainline",
  "first_epoch_gate": {
    "split": "val_seen",
    "variant": "C_goal_path_soft",
    "minimum_sr": 30
  },
  "trajectory_goal_k": 20,
  "trajectory_modes": 3,
  "trajectory_waypoints": 8,
  "trajectory_compact_mode": true,
  "trajectory_compact_enable_path": true,
  "trajectory_goal_soft_temperature_m": 20,
  "trajectory_path_soft_temperature_m": 5,
  "trajectory_ranking_loss_weight": 1,
  "trajectory_candidate_loss_weight": 0.5,
  "trajectory_loss_weight": 0,
  "trajectory_stop_weight": 0,
  "trajectory_sequential_backward": true,
  "trajectory_train_diagnostics": false,
  "profile_rollout": false,
  "fast_eval": true,
  "variants": {
    "A_refined_waypoint": {
      "trajectory_compact_mode": false,
      "trajectory_compact_enable_path": false,
      "trajectory_use_for_control": false,
      "trajectory_selector_mode": "prior",
      "trajectory_disable_learned_stop": true,
      "heatmap_execution": "waypoint",
      "trajectory_compact_refine_goal": false
    },
    "A_nms_waypoint": {
      "trajectory_compact_mode": true,
      "trajectory_compact_enable_path": false,
      "trajectory_use_for_control": false,
      "trajectory_selector_mode": "prior",
      "trajectory_disable_learned_stop": true,
      "heatmap_execution": "waypoint",
      "trajectory_compact_refine_goal": false
    },
    "B_goal_soft": {
      "trajectory_compact_mode": true,
      "trajectory_compact_enable_path": false,
      "trajectory_use_for_control": false,
      "trajectory_selector_mode": "joint",
      "trajectory_disable_learned_stop": true,
      "heatmap_execution": "waypoint",
      "trajectory_compact_refine_goal": false
    },
    "C_goal_path_soft": {
      "trajectory_compact_mode": true,
      "trajectory_compact_enable_path": true,
      "trajectory_use_for_control": false,
      "trajectory_selector_mode": "joint",
      "trajectory_disable_learned_stop": true,
      "heatmap_execution": "waypoint",
      "trajectory_compact_refine_goal": false
    }
  },
  "heatmap_waypoint_step_m": 50,
  "max_action_len": 20
}
